#!/bin/bash
#SBATCH --job-name=JULIA_POOL
#SBATCH --account=plgar2026-cpu
#SBATCH --partition=plgrid
#SBATCH --time=00:20:00
#SBATCH --ntasks=17
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --output=output/out_%j.txt
#SBATCH --error=output/err_%j.txt

source "_common_" 2>/dev/null

cd "$SLURM_SUBMIT_DIR"

module load openmpi/4.1.6-gcc-13.2.0

export JULIA_WIDTH=1280
export JULIA_HEIGHT=960

echo "GRID_JOB -> STARTED (SLURM_NTASKS=$SLURM_NTASKS)"

bash scripts/pipeline.sh grid

echo "GRID_JOB -> ENDED"
